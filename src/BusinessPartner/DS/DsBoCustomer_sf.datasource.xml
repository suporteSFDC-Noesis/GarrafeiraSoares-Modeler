<DataSource name="DsBoCustomer" backendSystem="sf" businessObjectClass="BoCustomer" external="false" editableEntity="Account" schemaVersion="2.0">
  <Attributes>
    <Attribute name="pKey" table="Account" column="Id" />
    <Attribute name="name" table="Account" column="Name" />
    <Attribute name="name2" table="Account" column="Name_2__c" />
    <Attribute name="matchcode" table="Account_Extension__c" column="Match_Code__c" />
    <Attribute name="customerId" table="Account" column="Account_Number__c" />
    <Attribute name="phone1" table="Account" column="Phone" />
    <Attribute name="email1" table="Account" column="Account_Email__c" />
    <Attribute name="fax1" table="Account" column="Fax" />
    <Attribute name="priority" table="Account_Extension__c" column="Priority__c" />
    <Attribute name="classOfTrade" table="Account_Extension__c" column="Class_Of_Trade__c" />
    <Attribute name="companyType" table="Account_Extension__c" column="Company_Type__c" />
    <Attribute name="orgLevel" table="Account_Extension__c" column="Org_Level__c" />
    <Attribute name="phase" table="Account_Extension__c" column="Phase__c" />
    <Attribute name="salesRelevant" table="Account_Extension__c" column="Sales_Relevant__c" />
    <Attribute name="state" table="Account_Extension__c" column="State__c" />
    <Attribute name="bpaMetaPKey" table="Account" column="Account_Template__c" />
    <Attribute name="dateClosure" table="Account_Extension__c" column="Date_Closure__c" />
    <DerivedAttribute name="deleted" value="'0'" />
    <Attribute name="accountExtensionId" table="Account_Extension__c" column="Id" />
    <DerivedAttribute name="totalDebit" value="0" />
    <DerivedAttribute name="totalCredit" value="0" />
    <DerivedAttribute name="totalDebitCredit" value="0" />
    <Attribute name="considerModules" table="Account_Extension__c" column="Consider_Modules__c" />
    <DerivedAttribute name="priorityImage" value="CASE Account_Extension__c.Priority__c WHEN 'A - Priority' THEN 'GoldMedal' WHEN 'B - Priority' THEN 'SilverMedal' ELSE 'BronzeMedal' END" />
    <Attribute name="accountDi" table="Account_Extension__c" column="Distribution_Issue__c" />
    <Attribute name="accountOi" table="Account_Extension__c" column="OOS_Issue__c" />
    <Attribute name="operatingHoursId" table="Account" column="OperatingHoursId" />
    <Attribute name="gasoVat" table="Account" column="GASO_VAT__c" />
    <Attribute name="gasoParentClient" table="Account" column="GASO_ParentClient__c" />
    <Attribute name="gasoFinantialStatus" table="Account" column="GASO_FinantialStatus__c" />
    <DerivedAttribute name="gasoFinantialStatusText" value="CASE Account.GASO_FinantialStatus__c WHEN '0' THEN 'Plafond Rigoroso' WHEN '1' THEN 'Registo Inativo' WHEN '2' THEN 'Plafond Confirmado' WHEN '3' THEN 'Plafond Rigoroso' WHEN '4' THEN 'Conta Confirmada' WHEN '5' THEN 'Conta em Alerta' WHEN '6' THEN 'Conta Cortada' WHEN '7' THEN 'Contencioso' WHEN '8' THEN 'Plafond Rigoroso' WHEN '9' THEN 'Conta Cortada' WHEN '11' THEN 'Conta em Alerta' ELSE 'Normal' END" />
    <Attribute name="gasoPaymentCondition" table="Account" column="GASO_PaymentCondition__c" />
    <DerivedAttribute name="gasoPaymentConditionText" value="CASE Account.GASO_PaymentCondition__c WHEN '1' THEN 'P.P.' WHEN '2' THEN '30 DIAS' WHEN '3' THEN '45 DIAS' WHEN '4' THEN '45 DIAS' WHEN '5' THEN '60 DIAS' WHEN '6' THEN '90 DIAS' WHEN '7' THEN '7 DIAS' WHEN '15' THEN '15 DIAS' WHEN '20' THEN 'P.P.*' WHEN '0' THEN '0' ELSE '' END" />
    <DerivedAttribute name="gasoPaymentDays" value="CASE Account.GASO_PaymentCondition__c WHEN '2' THEN 30 WHEN '3' THEN 45 WHEN '4' THEN 45 WHEN '5' THEN 60 WHEN '6' THEN 90 WHEN '7' THEN 7 WHEN '15' THEN 15 WHEN '1' THEN 0 WHEN '20' THEN 0 WHEN '0' THEN 0 ELSE -1 END" />
    <Attribute name="gasoLiableBalance" table="Account" column="GASO_LiableBalance__c" />
    <Attribute name="gasoCreditLimit" table="Account" column="GASO_CreditLimit__c" />
    <Attribute name="gasoStatus" table="Account" column="GASO_Status__c" />
    <DerivedAttribute name="gasoStatusText" value="CASE Account.GASO_Status__c WHEN 'New' THEN 'Novo' WHEN 'InApproval' THEN 'Em Aprovação' WHEN 'ApprovedWithoutCredit' THEN 'Aprovado sem Crédito' WHEN 'Approved' THEN 'Aprovado' WHEN 'Rejected' THEN 'Rejeitado' WHEN 'Inactive' THEN 'Inativo' ELSE '' END" />
    <Attribute name="gasoMobilePhone" table="Account" column="GASO_MobilePhone__c" />
    <Attribute name="gasoIdentifier" table="Account" column="GASO_Identifier__c" />
    <Attribute name="gasoArtsoftNrFicha" table="Account" column="GASO_ArtsoftNrFicha__c" />
    <DerivedAttribute name="gasoShippingAddress" value="TRIM(IFNULL(Account.ShippingStreet, '') || ', ' || IFNULL(Account.ShippingPostalCode, '') || ' ' || IFNULL(Account.ShippingCity, ''), ', ')" />
    <DerivedAttribute name="emailEditable" value="'0'" />
  </Attributes>
  <Entities>
    <Entity name="Account" alias="" idAttribute="Id" />
    <Entity name="Account_Extension__c" alias="">
      <Join Type="inner">
        <SimpleJoin>
          <Condition leftSideValue="Account_Extension__c.Account__c" comparator="eq" rightSideType="Attribute" rightSideValue="Account.Id" />
        </SimpleJoin>
      </Join>
    </Entity>
  </Entities>
  <QueryCondition><![CDATA[
   Account.Id = #pKey#
          ]]></QueryCondition>
  <OrderCriteria />
  <Parameters>
    <Parameter name="pKey" type="TEXT" />
  </Parameters>
</DataSource>